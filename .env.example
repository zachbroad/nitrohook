DATABASE_URL=postgres://nitrohook:nitrohook@localhost:5432/nitrohook?sslmode=disable
REDIS_URL=redis://localhost:6379
PORT=8080
WORKER_CONCURRENCY=4
MAX_RETRIES=5
RETRY_BASE_DELAY=5s
DELIVERY_TIMEOUT=10s
POLL_INTERVAL=30s
# Comma-separated origins allowed to call /api from a browser (the React admin SPA).
# Defaults to the Vite dev server origin when unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173
